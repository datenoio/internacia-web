{
  "name": "internacia-web-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist --quiet --exclude-selectors '.table-wrap, .page-toc, .chart, .map, .cite, .filters, .explorer-controls, .bars, [aria-labelledby=links], [aria-labelledby=provenance]'",
    "preview": "astro preview",
    "audit": "node scripts/audit.mjs"
  },
  "dependencies": {
    "astro": "7.4.13",
    "d3-geo": "3.1.2",
    "marked": "18.2.1",
    "topojson-client": "3.1.0",
    "world-atlas": "2.0.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@expo-google-fonts/inter": "0.4.2",
    "@resvg/resvg-js": "2.6.2",
    "chrome-launcher": "1.2.3",
    "lighthouse": "13.6.0",
    "pagefind": "1.6.0",
    "playwright": "1.65.1",
    "sharp": "0.35.5"
  }
}
