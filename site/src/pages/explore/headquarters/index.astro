---
import Base from '../../../layouts/Base.astro';
import { blockById } from '../../../lib/data';
import { blocktypeLabel, displayName, num } from '../../../lib/format';
import { headquarters, hqClusters } from '../../../lib/explore';
import { blockPath, countryPath, path } from '../../../lib/urls';
import { worldMap } from '../../../lib/worldmap';

// Headquarters map (SPEC §8, V5). Rendered at build time: the base map inline, one focusable
// point per city linking to that city's row in the table below. Works without JavaScript.
const clusters = hqClusters();
const total = headquarters().length;
const { svg, width, height } = worldMap();
const radius = (k: number) => Math.round((3 + Math.sqrt(k) * 1.8) * 10) / 10;
const anchor = (key: string) => `city-${key.replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')}`;
const points = [...clusters]
  .reverse() // small points on top of big ones
  .map((c) => {
    const label = `${c.city}${c.country_name ? `, ${c.country_name}` : ''}: ${c.ids.length} organization${c.ids.length === 1 ? '' : 's'}`;
    return `<a class="hq-point" href="#${anchor(c.key)}" aria-label="${label.replace(/"/g, '&quot;')}"><title>${label.replace(/</g, '&lt;')}</title><circle cx="${c.x}" cy="${c.y}" r="${radius(c.ids.length)}"/></a>`;
  })
  .join('');
const mapSvg = svg.replace('</svg>', `<g class="hq">${points}</g></svg>`).replace('<svg ', '<svg role="group" aria-label="Headquarters by city" ');
const top = clusters.slice(0, 5);
---

<Base

  section="Explore"
  title="Headquarters map"
  description={`Where international organizations are based: ${total} headquarters in ${clusters.length} cities.`}
  breadcrumbs={[
    { name: 'Explore', href: path('explore/') },
    { name: 'Headquarters map', href: path('explore/headquarters/') },
  ]}
>
  <section class="container page-head">
    <h1>Headquarters map</h1>
    <p class="lead">
      {num(total)} intblocks with headquarters coordinates, in {num(clusters.length)} cities. The largest hubs:
      {top.map((c, i) => `${c.city} (${c.ids.length})${i < top.length - 1 ? ', ' : '.'}`).join('')}
    </p>
  </section>
  <section class="container hq-layout" data-hq>
    <figure class="map">
      <div class="map-canvas" style={`--map-ratio: ${width} / ${height}`} set:html={mapSvg} />
      <figcaption>
        <span class="muted small">
          One point per city; its area grows with the number of organizations. Select a point to list the city's organizations.
          Base map: Natural Earth (public domain); boundaries do not imply endorsement.
        </span>
      </figcaption>
    </figure>
    {/* Details of the selected city, filled from its row in the table below (scripts in this
        page); without JavaScript the points jump to the rows instead. */}
    <aside class="hq-panel js-only" aria-labelledby="hq-panel-title">
      <div class="hq-panel-inner" data-hq-panel>
        <h2 id="hq-panel-title" tabindex="-1">Select a city</h2>
        <p class="muted small">Choose a point on the map to list the organizations based there. The largest hubs:</p>
        <ul class="hq-hubs">
          {
            top.map((c) => (
              <li>
                <button type="button" data-city={anchor(c.key)}>
                  {c.city} <span class="muted">{num(c.ids.length)}</span>
                </button>
              </li>
            ))
          }
        </ul>
      </div>
    </aside>
  </section>
  <section class="container card-section offscreen" aria-labelledby="cities">
    <h2 id="cities">Cities</h2>
    <div class="table-wrap">
      <table class="data" id="hq-table">
        <thead>
          <tr>
            <th scope="col">City</th>
            <th scope="col">Country</th>
            <th scope="col" class="num">Organizations</th>
            <th scope="col">Organizations based there</th>
          </tr>
        </thead>
        <tbody>
          {
            clusters.map((c) => (
              <tr id={anchor(c.key)}>
                <td>{c.city}</td>
                <td>{c.country && c.country_name ? <a href={countryPath(c.country)}>{c.country_name}</a> : (c.country ?? '')}</td>
                <td class="num">{num(c.ids.length)}</td>
                <td>
                  {c.ids.map((id, i) => {
                    const b = blockById().get(id)!;
                    return (
                      <>
                        <a href={blockPath(id)} data-type={blocktypeLabel(b.blocktype[0])}>{displayName(b.name, b._acronym)}</a>
                        {!b._active && <span class="muted small"> (historical)</span>}
                        {i < c.ids.length - 1 ? '; ' : ''}
                      </>
                    );
                  })}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>
  <script>
    import { esc, params, setParams } from '../../../scripts/explore';

    const root = document.querySelector<HTMLElement>('[data-hq]')!;
    const panel = root.querySelector<HTMLElement>('[data-hq-panel]')!;
    const points = Array.from(root.querySelectorAll<SVGAElement>('a.hq-point'));
    const idOf = (a: SVGAElement) => (a.getAttribute('href') ?? '').slice(1);

    // Fill the panel from the city's table row: organizations grouped by their first block type.
    function open(id: string, focus: boolean) {
      const row = document.getElementById(id);
      if (!row) return;
      const [city, country, count] = Array.from(row.cells).map((c) => c.innerHTML);
      const groups = new Map<string, string[]>();
      row.cells[3].querySelectorAll<HTMLAnchorElement>('a[data-type]').forEach((a) => {
        const type = a.dataset.type ?? 'Other';
        const historical = a.nextElementSibling?.classList.contains('muted') ? ' <span class="muted small">(historical)</span>' : '';
        groups.set(type, [...(groups.get(type) ?? []), `<li><a href="${esc(a.getAttribute('href'))}">${esc(a.textContent)}</a>${historical}</li>`]);
      });
      const sorted = [...groups.entries()].sort((a, b) => b[1].length - a[1].length || a[0].localeCompare(b[0]));
      panel.innerHTML = `<h2 id="hq-panel-title" tabindex="-1">${city}${country ? `, ${country}` : ''}</h2>
        <p class="muted small">${count} organization${count === '1' ? '' : 's'}, by block type. <a href="#${esc(id)}">Row in the table</a>.</p>
        <label class="hq-filter">Filter<input type="search" placeholder="Name or acronym" data-hq-filter /></label>
        ${sorted.map(([type, items]) => `<section class="hq-group"><h3>${esc(type)} <span class="muted">${items.length}</span></h3><ul>${items.join('')}</ul></section>`).join('')}`;
      const filter = panel.querySelector<HTMLInputElement>('[data-hq-filter]')!;
      filter.addEventListener('input', () => {
        const q = filter.value.trim().toLocaleLowerCase();
        panel.querySelectorAll<HTMLElement>('.hq-group').forEach((g) => {
          let any = false;
          g.querySelectorAll<HTMLLIElement>('li').forEach((li) => {
            const show = !q || (li.textContent ?? '').toLocaleLowerCase().includes(q);
            li.hidden = !show;
            any ||= show;
          });
          g.hidden = !any;
        });
      });
      points.forEach((p) => p.classList.toggle('is-selected', idOf(p) === id));
      panel.scrollTop = 0;
      setParams({ city: id.replace(/^city-/, '') });
      if (focus) panel.querySelector<HTMLElement>('h2')?.focus();
    }

    points.forEach((p) =>
      p.addEventListener('click', (e) => {
        e.preventDefault();
        open(idOf(p), true);
      }),
    );
    panel.addEventListener('click', (e) => {
      const hub = (e.target as Element).closest<HTMLButtonElement>('button[data-city]');
      if (hub) open(hub.dataset.city!, true);
    });
    const city = params().get('city');
    if (city) open(`city-${city}`, false);
  </script>
</Base>
