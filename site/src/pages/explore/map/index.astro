---
import EntityPicker from '../../../components/EntityPicker.astro';
import MapFrame from '../../../components/MapFrame.astro';
import Base from '../../../layouts/Base.astro';
import { blocktypes } from '../../../lib/data';
import { enumLabel } from '../../../lib/format';
import { path } from '../../../lib/urls';

const types = blocktypes()
  .filter((t) => t._count > 0)
  .sort((a, b) => a.name.localeCompare(b.name));
const scopes = ['igo', 'treaty_body', 'policy_forum', 'reference_enumeration', 'intergovernmental_body', 'non_state_organization'];
---

<Base

  section="Explore"
  title="Membership map"
  description="Map the members of any international organization or grouping, or the number of memberships per country, filtered by block type or scope."
  breadcrumbs={[
    { name: 'Explore', href: path('explore/') },
    { name: 'Membership map', href: path('explore/map/') },
  ]}
>
  <section class="container page-head">
    <h1>Membership map</h1>
    <p class="lead">Members of one organization by status, or the number of current memberships of every country.</p>
  </section>
  <section class="container" data-explorer="map" data-base={path()}>
    <div class="explorer-controls js-only">
      <fieldset class="explorer-controls" style="border:0;margin:0;padding:0">
        <legend class="visually-hidden">What to show</legend>
        <label class="inline"><input type="radio" name="mode" value="block" checked /> One organization</label>
        <label class="inline"><input type="radio" name="mode" value="count" /> Memberships per country</label>
      </fieldset>
      <div data-for="block"><EntityPicker id="map-block" /></div>
      <label data-for="count" hidden
        >Block type
        <select data-input="type"><option value="">All types</option>{types.map((t) => <option value={t.id}>{t.name}</option>)}</select>
      </label>
      <label data-for="count" hidden
        >Scope category
        <select data-input="scope"><option value="">All scopes</option>{scopes.map((s) => <option value={s}>{enumLabel('scope_category', s)}</option>)}</select>
      </label>
    </div>
    <p class="explorer-status" role="status" aria-live="polite" data-status></p>
    <MapFrame id="explore-map" label="Membership map" />
    <h2 class="visually-hidden">Data behind this map</h2>
    <details open data-table-wrap>
      <summary class="small">Data behind this map</summary>
      <div class="table-wrap" data-table>
        <p class="muted small">This explorer needs JavaScript. Every organization's members are on its card: see the <a href={path('blocks/')}>list of organizations</a>.</p>
      </div>
    </details>
  </section>
  <script>
    import { bins, esc, GROUPS, groupOf, n, RANK, type Group } from '../../../scripts/charts';
    import { getJson, params, setParams } from '../../../scripts/explore';
    import { renderMap, type MapEntry } from '../../../scripts/map';

    interface Lite { id: string; name: string; _acronym: string | null; blocktype: string[]; scope_category: string | null; _active: boolean }
    interface Roster { id: string; name: string | null; type: string; status: string; joined: string | null; current: boolean; link: string | null }

    const root = document.querySelector<HTMLElement>('[data-explorer="map"]')!;
    const base = root.dataset.base!;
    const api = (p: string) => `${base}api/v1/${p}`;
    const figure = document.getElementById('explore-map')!;
    const status = root.querySelector<HTMLElement>('[data-status]')!;
    const table = root.querySelector<HTMLElement>('[data-table]')!;
    const legend = figure.querySelector<HTMLElement>('[data-legend]')!;
    const caption = figure.querySelector<HTMLElement>('[data-caption]')!;
    const blockInput = root.querySelector<HTMLInputElement>('[data-input="block"]')!;
    const typeSel = root.querySelector<HTMLSelectElement>('[data-input="type"]')!;
    const scopeSel = root.querySelector<HTMLSelectElement>('[data-input="scope"]')!;
    const modes = root.querySelectorAll<HTMLInputElement>('input[name="mode"]');

    const cardUrl = (kind: 'countries' | 'blocks', id: string) => `${base}${kind}/${id.toLowerCase()}/`;
    const legendItems = (items: { cls: string; label: string }[]) =>
      (legend.innerHTML = items.map((i) => `<li><span class="swatch ${esc(i.cls)}" aria-hidden="true"></span>${esc(i.label)}</li>`).join(''));

    async function showBlock(id: string) {
      const lite = await getJson<{ data: Lite[] }>(api('blocks.json'));
      const b = lite.data.find((x) => x.id === id);
      if (!b) {
        status.textContent = `No organization with ID ${id}.`;
        return;
      }
      const doc = await getJson<{ data: { name: string; _active: boolean; _roster: Roster[] } }>(api(`blocks/${encodeURIComponent(id)}.json`));
      const data: Record<string, MapEntry> = {};
      const rows = doc.data._roster.filter((r) => r.link === 'country');
      for (const r of rows) {
        const g: Group = doc.data._active ? (r.current ? groupOf(r.status) : 'f') : groupOf(r.status);
        const prev = data[r.id];
        if (!prev || RANK[g] > RANK[prev[0].slice(2) as Group]) data[r.id] = [`g-${g}`, r.status.replace(/_/g, ' '), r.joined ?? '', r.name ?? r.id];
      }
      // Zoom to the current members (all entries of a historical block).
      await renderMap(figure, data, Object.keys(data).filter((code) => !doc.data._active || data[code][0] !== 'g-f'));
      const present = (Object.keys(GROUPS) as Group[]).filter((g) => Object.values(data).some(([c]) => c === `g-${g}`));
      legendItems(present.map((g) => ({ cls: `g-${g}`, label: GROUPS[g] })));
      const label = `${b.name}${b._acronym ? ` (${b._acronym})` : ''}`;
      blockInput.value = `${id} — ${label}`;
      caption.textContent = `${label}: ${rows.filter((r) => r.current).length} current countries and territories.`;
      status.innerHTML = `Showing <a href="${esc(cardUrl('blocks', id))}">${esc(label)}</a>.`;
      table.innerHTML = `<table class="data"><thead><tr><th scope="col">Country or territory</th><th scope="col">Code</th><th scope="col">Status</th><th scope="col">Joined</th><th scope="col">Current</th></tr></thead><tbody>${rows
        .map((r) => `<tr><td><a href="${esc(cardUrl('countries', r.id))}">${esc(r.name)}</a></td><td><code>${esc(r.id)}</code></td><td>${esc(r.status.replace(/_/g, ' '))}</td><td>${esc(r.joined)}</td><td>${r.current ? 'yes' : 'no'}</td></tr>`)
        .join('')}</tbody></table>`;
      setParams({ mode: null, id, type: null, scope: null });
    }

    async function showCount(type: string, scope: string) {
      const [lite, edges, countries] = await Promise.all([
        getJson<{ data: Lite[] }>(api('blocks.json')),
        getJson<{ data: [string, string, string, string | null][] }>(api('memberships.json')),
        getJson<{ data: { code: string; name: string }[] }>(api('countries.json')),
      ]);
      const keep = new Set(lite.data.filter((b) => (!type || b.blocktype.includes(type)) && (!scope || b.scope_category === scope)).map((b) => b.id));
      const counts = new Map<string, number>();
      for (const [block, code] of edges.data) if (keep.has(block)) counts.set(code, (counts.get(code) ?? 0) + 1);
      const names = new Map(countries.data.map((c) => [c.code, c.name]));
      const max = Math.max(0, ...counts.values());
      const steps = bins(max);
      const data: Record<string, MapEntry> = {};
      for (const [code, value] of counts) {
        const bin = steps.find((s) => value >= s.min && value <= s.max)!;
        data[code] = [bin.cls, `${n(value)} memberships`, '', names.get(code) ?? code];
      }
      await renderMap(figure, data, []);
      legendItems(steps.filter((s) => Object.values(data).some(([c]) => c === s.cls)));
      const filter = [type && typeSel.selectedOptions[0]?.text, scope && scopeSel.selectedOptions[0]?.text].filter(Boolean).join(', ');
      caption.textContent = `Current memberships per country${filter ? ` in ${filter}` : ''}: ${keep.size} intblocks.`;
      status.textContent = `${counts.size} countries and territories have at least one such membership.`;
      const rows = [...counts.entries()].sort((a, b) => b[1] - a[1] || (names.get(a[0]) ?? '').localeCompare(names.get(b[0]) ?? ''));
      table.innerHTML = `<table class="data"><thead><tr><th scope="col">Country or territory</th><th scope="col">Code</th><th scope="col" class="num">Memberships</th></tr></thead><tbody>${rows
        .map(([code, v]) => `<tr><td><a href="${esc(cardUrl('countries', code))}">${esc(names.get(code) ?? code)}</a></td><td><code>${esc(code)}</code></td><td class="num">${n(v)}</td></tr>`)
        .join('')}</tbody></table>`;
      setParams({ mode: 'count', id: null, type, scope });
    }

    const setMode = (mode: string) => {
      modes.forEach((m) => (m.checked = m.value === mode));
      root.querySelectorAll<HTMLElement>('[data-for]').forEach((el) => (el.hidden = el.dataset.for !== mode));
    };
    const run = () => {
      const mode = [...modes].find((m) => m.checked)?.value ?? 'block';
      if (mode === 'count') void showCount(typeSel.value, scopeSel.value);
      else {
        const id = blockInput.value.split(' — ')[0].trim();
        if (id) void showBlock(id);
      }
    };

    modes.forEach((m) => m.addEventListener('change', () => (setMode(m.value), run())));
    blockInput.addEventListener('change', run);
    typeSel.addEventListener('change', run);
    scopeSel.addEventListener('change', run);

    const p = params();
    if (p.get('mode') === 'count') {
      typeSel.value = p.get('type') ?? '';
      scopeSel.value = p.get('scope') ?? '';
      setMode('count');
    } else {
      blockInput.value = p.get('id') ?? 'EU';
      setMode('block');
    }
    run();
  </script>
</Base>
