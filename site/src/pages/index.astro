---
import BarList from '../components/BarList.astro';
import ExploreTiles from '../components/ExploreTiles.astro';
import MembershipMap from '../components/MembershipMap.astro';
import Base from '../layouts/Base.astro';
import { blockById, blocktypes, countries } from '../lib/data';
import { displayName } from '../lib/format';
import { meta } from '../lib/meta';
import { blockPath, path, typePath } from '../lib/urls';

const fmt = new Intl.NumberFormat('en');
const { counts } = meta;

const figures = [
  { value: counts.countries, label: 'Countries and territories', note: `${fmt.format(counts.iso_countries)} ISO 3166-1`, href: path('countries/') },
  { value: counts.intblocks, label: 'Organizations and groupings', href: path('blocks/') },
  { value: counts.trade_agreements, label: 'Trade agreements', note: `${fmt.format(counts.trade_agreements_in_force)} in force`, href: path('agreements/') },
  { value: counts.blocktypes, label: 'Block types', href: path('types/') },
  { value: counts.topics, label: 'Topics', href: path('topics/') },
  { value: counts.memberships, label: 'Membership records', note: `${fmt.format(counts.current_memberships)} current`, href: path('stats/') },
];

const FEATURED = ['UN', 'EU', 'AFUNION', 'ASEAN', 'NATO', 'OECD', 'G-20', 'BRICS', 'COMMONWEALTH', 'OSCE'];
const featured = FEATURED.map((id) => blockById().get(id)).filter((b) => b !== undefined);
const topTypes = blocktypes()
  .slice()
  .sort((a, b) => b._count - a._count)
  .slice(0, 12)
  .map((t) => ({ label: t.name, value: t._count, href: typePath(t.id) }));
const perCountry = Object.fromEntries(countries().map((c) => [c.code, c._current_member_count]));
// Ready-made questions under the home finder: plain links into cards, lists and explorers.
const intents = [
  { label: 'NATO', href: blockPath('NATO') },
  { label: 'Compare EU, NATO and OECD', href: path('explore/compare/?ids=EU,NATO,OECD') },
  { label: 'France and Germany side by side', href: path('explore/countries/?codes=FR,DE') },
  { label: 'Political organizations', href: path('blocks/?types=political') },
  { label: 'Founded since 2000', href: path('blocks/?founded-from=2000') },
  { label: 'Based in Geneva', href: path('explore/headquarters/?city=geneva') },
  { label: 'How ASEAN grew', href: path('explore/timeline/?id=ASEAN') },
];
---

<Base

  section="Home"
  title="Internacia"
  description="Countries, international organizations and country groupings from internacia-db, as cards, maps and timelines for people and AI agents."
  markdown={path('index.md')}
  json={path('api/v1/index.json')}
>
  <section class="container hero">
    <h1>Internacia</h1>
    <p class="lead">
      Countries, international organizations and country groupings from
      <a href="https://github.com/datenoio/internacia-db">internacia-db</a>, as cards for people and for AI agents.
      Every card is also available as Markdown and JSON.
    </p>
    <div class="finder finder-hero js-only" data-finder data-index={path('api/v1/search-index.json')} data-search={path('search/')}>
      <label class="visually-hidden" for="home-finder-input">Find a country or organization</label>
      <input
        id="home-finder-input"
        type="search"
        role="combobox"
        aria-autocomplete="list"
        aria-expanded="false"
        aria-controls="home-finder-results"
        placeholder="Search a country or organization in any language: France, НАТО, 北约…"
        autocomplete="off"
        spellcheck="false"
      />
      <ul id="home-finder-results" role="listbox" aria-label="Matches" hidden></ul>
    </div>
    <ul class="intents" aria-label="Examples">
      {
        intents.map((i) => (
          <li>
            <a href={i.href}>{i.label}</a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="container" aria-labelledby="figures-heading">
    <h2 id="figures-heading">In internacia-db v{meta.data.version}</h2>
    <dl class="figures">
      {
        figures.map((f) => (
          <div class="figure">
            <dt>{f.href ? <a href={f.href}>{f.label}</a> : f.label}</dt>
            <dd>
              <span class="figure-value">{fmt.format(f.value)}</span>
              {f.note && <span class="figure-note">{f.note}</span>}
            </dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="container card-section" aria-labelledby="map-heading">
    <h2 id="map-heading">Memberships per country</h2>
    <p class="muted small">
      Current memberships of each country and territory in international organizations and groupings. Exact numbers are in the
      <a href={path('countries/')}>list of countries</a>.
    </p>
    <MembershipMap values={{ label: 'current memberships', data: perCountry }} />
  </section>

  <div class="container grid-2">
    <section class="card-section" aria-labelledby="featured-heading">
      <h2 id="featured-heading">Featured organizations</h2>
      <ul class="featured">
        {
          featured.map((b) => (
            <li>
              <a href={blockPath(b!.id)}>{displayName(b!.name, b!._acronym)}</a>
              <span class="muted small"> {fmt.format(b!._current_member_count)} members</span>
            </li>
          ))
        }
      </ul>
      <p><a href={path('blocks/')}>Browse all {fmt.format(counts.intblocks)} organizations and groupings</a></p>
    </section>

    <section class="card-section" aria-labelledby="types-heading">
      <h2 id="types-heading">Largest block types</h2>
      <BarList items={topTypes} label="Intblocks per block type, largest 12" />
    </section>
  </div>

  <section class="container card-section" aria-labelledby="explore-heading">
    <h2 id="explore-heading">Explore</h2>
    <ExploreTiles level={3} />
  </section>

  <section class="container card-section" aria-labelledby="dev-heading">
    <h2 id="dev-heading">For developers and AI agents</h2>
    <ul>
      <li><a href={path('llms.txt')}>llms.txt</a>: how to use this site from an AI agent, in one file.</li>
      <li><a href={path('api/v1/index.json')}>Static JSON API</a>: every country and organization as JSON.</li>
      <li><a href={path('data/')}>Data and downloads</a>: DuckDB, Parquet and JSONL with checksums, and how to cite.</li>
    </ul>
  </section>
</Base>

<style>
  .hero {
    padding-block: var(--space-5) var(--space-3);
  }

  h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    margin: 0 0 var(--space-2);
  }

</style>
