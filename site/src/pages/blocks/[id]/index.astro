---
import AliasPage from '../../../components/AliasPage.astro';
import Facts from '../../../components/Facts.astro';
import MembershipMap from '../../../components/MembershipMap.astro';
import Cite from '../../../components/Cite.astro';
import PageToc from '../../../components/PageToc.astro';
import StatusDefs from '../../../components/StatusDefs.astro';
import EmbedCode from '../../../components/EmbedCode.astro';
import Base from '../../../layouts/Base.astro';
import { aliases, blockById, blocks, type Block, type BlockRef } from '../../../lib/data';
import {
  blocktypeDeprecated,
  blocktypeLabel,
  enumLabel,
  humanize,
  num,
  roleDescription,
  roleLabel,
  splitCode,
  statusDeprecated,
  statusLabel,
  topicLabel,
} from '../../../lib/format';
import { blockEmbeddable } from '../../../lib/embed';
import { designRows } from '../../../lib/design';
import { meta } from '../../../lib/meta';
import { steps } from '../../../scripts/charts';
import { blockLd } from '../../../lib/jsonld';
import { agreementStatusLabel, agreementTypeLabel } from '../../../lib/agreements';
import { agreementPath, blockJson, blockMd, blockPath, countryPath, path, reportErrorUrl, sourceUrl, topicPath, typePath, wikidataUrl } from '../../../lib/urls';

export function getStaticPaths() {
  const pages = blocks().map((b) => ({ params: { id: b.id.toLowerCase() }, props: { id: b.id, alias: null } }));
  const extra = aliases()
    .pages.filter((a) => a.section === 'blocks')
    .map((a) => ({ params: { id: a.alias.toLowerCase() }, props: { id: null, alias: a } }));
  return [...pages, ...extra];
}

const { id, alias } = Astro.props;
const b = id ? (blockById().get(id) as Block) : null;

const current = b ? b._roster.filter((r) => r.current) : [];
const other = b ? b._roster.filter((r) => !r.current) : [];
const listed = b ? (b._active ? current : b._roster) : [];
const statusOptions = [...new Set(listed.map((r) => r.status))];
const countryCount = b?._current_member_count ?? 0;
const countsComparable = b && b.membership_count !== undefined && (!b.membership_count_type || b.membership_count_type === 'countries');
const known = (id: string) => blockById().has(id);
const refLink = (r: BlockRef | null) => (r && r.exists ? blockPath(r.id) : undefined);
const links = b
  ? [
      ...(b.links ?? []).map((l) => ({ label: humanize(l.type), url: l.url })),
      ...(b.official_documents ?? []).map((d) => ({ label: d.title ?? 'Official document', url: d.url })),
      ...Object.entries(b.social_media ?? {}).map(([k, v]) => ({ label: humanize(k), url: v })),
    ]
  : [];
const statusSummary = b
  ? Object.entries(b._status_counts)
      .map(([s, n]) => `${num(n)} ${statusLabel(s).toLowerCase()}`)
      .join(', ')
  : '';
const orgCount = current.length - countryCount;
const countryRows = b ? b._roster.filter((r) => r.type === 'country' || r.type === 'territory') : [];
const dated = countryRows.filter((r) => r.joined).length;
const hasTimeline = dated >= 3 && dated >= countryRows.length * 0.3;
// Membership over time (SPEC §6.5, item 6): the same series as the accession timeline explorer.
const year = (d: string | null) => (d && /^\d{4}/.test(d) ? Number(d.slice(0, 4)) : null);
const thisYear = Number(meta.data.build_date.slice(0, 4));
const timeEntries = countryRows.filter((r) => year(r.joined) !== null).map((r) => ({ from: year(r.joined)!, to: year(r.left) }));
const series: { year: number; value: number }[] = [];
if (hasTimeline) {
  const first = Math.min(...timeEntries.map((e) => e.from));
  for (let y = first; y <= thisYear; y++) series.push({ year: y, value: timeEntries.filter((e) => e.from <= y && (e.to === null || e.to > y)).length });
}
const seriesChanges = series.filter((p, i) => i === 0 || p.value !== series[i - 1].value);
// Columns that would be empty or the same in every row are left out.
const cols = (rows: typeof listed) => ({
  type: new Set(rows.map((r) => r.type)).size > 1,
  role: rows.some((r) => r.role),
  joined: rows.some((r) => r.joined),
  left: rows.some((r) => r.left),
});
const listedCols = cols(listed);
const otherCols = cols(other);
const acronyms = b ? [...new Map((b.acronyms ?? []).map((a) => [`${a.lang}:${a.value}`, a])).values()] : [];
// Institutional design (contract 4.1): absent subfields are unknown and left out.
const design = b ? designRows(b.institutional_design) : [];
const hasStructure = b ? b._parents.length > 0 || b._children.length > 0 || Boolean(b._predecessor) || Boolean(b._successor) || (b.previous_names?.length ?? 0) > 0 : false;
// In-page navigation, in page order.
const toc = b
  ? [
      { id: 'facts', label: 'Key facts' },
      ...(hasStructure ? [{ id: 'structure', label: 'Structure' }] : []),
      ...(design.length > 0 ? [{ id: 'design', label: 'Institutional design' }] : []),
      ...(b.notes ? [{ id: 'notes', label: 'Notes' }] : []),
      { id: 'roster', label: 'Members', count: b._active && !(b.membership_applicability === 'not_applicable' && b._roster.length === 0) ? countryCount : undefined },
      ...(b._party_to_agreements.length > 0 ? [{ id: 'trade', label: 'Trade agreements', count: b._party_to_agreements.length }] : []),
      ...(b._similar.length > 0 ? [{ id: 'overlap', label: 'Overlapping organizations' }] : []),
      ...(acronyms.length > 0 || (b.other_names?.length ?? 0) > 0 ? [{ id: 'names', label: 'Names' }] : []),
      ...(links.length > 0 ? [{ id: 'links', label: 'Links' }] : []),
      ...((b.provenance?.length ?? 0) > 0 ? [{ id: 'provenance', label: 'Provenance' }] : []),
    ]
  : [];
---

{alias && <AliasPage alias={alias} />}
{
  b && (
    <Base
      section="Organizations"
      title={b._acronym ? `${b.name} (${b._acronym})` : b.name}
      description={`${b.name}${b._acronym ? ` (${b._acronym})` : ''}: ${enumLabel('status', b.status).toLowerCase()} ${blocktypeLabel(b.blocktype[0]).toLowerCase()} with ${countryCount} ${b._active ? 'current' : 'recorded'} member countries. Roster, structure, names and links.`}
      breadcrumbs={[
        { name: 'Organizations', href: path('blocks/') },
        { name: b._acronym ?? b.name, href: blockPath(b.id) },
      ]}
      markdown={blockMd(b.id)}
      json={blockJson(b.id)}
      sourceUrl={sourceUrl(b._source_path)}
      reportUrl={reportErrorUrl('intblocks', b.id, b.name)}
      jsonld={blockLd(b)}
      ogImage={path(`og/blocks/${b.id.toLowerCase()}.png`)}
      ogAlt={`${b.name}: map of member countries and territories`}
    >
      <section class="container page-head">
        <h1>
          {b.name}
          {b._acronym && <span class="muted"> ({b._acronym})</span>}
        </h1>
        {/* Three kinds of badge: status and scope (filled status first), block types (square
            marker) and topics (dashed), each kind on its own labelled line. */}
        <ul class="badges">
          <li class={b._active ? 'badge badge-status' : 'badge badge-warn'}>
            {`${enumLabel('status', b.status)}${!b._active && b.dissolved ? `, dissolved ${b.dissolved}` : ''}`}
          </li>
          {b.scope_category && <li class="badge">{enumLabel('scope_category', b.scope_category)}</li>}
          {b.geographic_scope && <li class="badge">{enumLabel('geographic_scope', b.geographic_scope)} scope</li>}
        </ul>
        <div class="badge-line">
          <span class="badge-label" id="types-label">{b.blocktype.length > 1 ? 'Block types' : 'Block type'}</span>
          <ul class="badges" aria-labelledby="types-label">
            {b.blocktype.map((t) => (
              <li>
                <a class="badge badge-type" href={typePath(t)}>
                  {blocktypeLabel(t)}
                  {blocktypeDeprecated(t) && <span class="muted"> (deprecated)</span>}
                </a>
              </li>
            ))}
          </ul>
        </div>
        {(b.topics?.length ?? 0) > 0 && (
          <div class="badge-line">
            <span class="badge-label" id="topics-label">{b.topics!.length > 1 ? 'Topics' : 'Topic'}</span>
            <ul class="badges" aria-labelledby="topics-label">
              {b.topics!.map((t) => (
                <li>
                  <a class="badge badge-topic" href={topicPath(t.key)}>{topicLabel(t.key, t.name)}</a>
                </li>
              ))}
            </ul>
          </div>
        )}
        {b.description && <p class="lead">{b.description}</p>}
        <Cite title={b._acronym ? `${b.name} (${b._acronym})` : b.name} href={blockPath(b.id)} />
        {b._alias_notes.map((n) =>
          n.kind === 'former_id' ? (
            <p class="muted small">
              Also formerly under ID <code>{n.alias}</code> ({n.reason} in v{n.since}).
            </p>
          ) : (
            <p class="notice small">{n.note}</p>
          ),
        )}
      </section>

      <PageToc items={toc} />

      <div class="container">
        <div class="grid-2">
          <section class="card-section" aria-labelledby="facts">
            <h2 id="facts">Key facts</h2>
            <Facts
              rows={[
                { label: 'ID', value: b.id, code: true, copy: true },
                { label: 'Wikidata', value: b.wikidata_id, code: true, href: b.wikidata_id ? wikidataUrl(b.wikidata_id) : undefined, copy: true },
                { label: 'Founded', value: b.founded },
                { label: 'Dissolved', value: b.dissolved },
                {
                  label: 'Active period',
                  value: b.active_period ? [b.active_period.start, b.active_period.end ?? 'present'].filter(Boolean).join(' – ') : undefined,
                },
                {
                  label: 'Headquarters',
                  value: b.headquarters?.city
                    ? [b.headquarters.city, b._hq_country_name ?? b.headquarters.country].filter(Boolean).join(', ')
                    : undefined,
                  href: b.headquarters?.country && b._hq_country_name ? countryPath(b.headquarters.country) : undefined,
                  note: b.headquarters?.note,
                },
                {
                  label: 'Secretariat',
                  value: b.secretariat ? [b.secretariat.organization, b.secretariat.location].filter(Boolean).join(', ') : undefined,
                },
                { label: 'Official languages', value: b.languages?.join(', ') },
                { label: 'Regions', value: b.regions?.join(', ') },
                { label: 'Legal status', value: b.legal_status ? humanize(b.legal_status) : undefined },
                { label: 'Recognition', value: b.recognition_status },
                {
                  label: 'Official member count',
                  value:
                    b.membership_count !== undefined
                      ? `${num(b.membership_count)}${b.membership_count_type ? ` ${b.membership_count_type}` : ''}`
                      : undefined,
                  note:
                    countsComparable && b._active && b.membership_count !== countryCount
                      ? `(the roster lists ${countryCount} current countries and territories)`
                      : undefined,
                },
                { label: 'Last verified', value: b.last_verified },
                {
                  label: 'Trade agreement record',
                  value: b._trade_agreement
                    ? `${agreementStatusLabel(b._trade_agreement.status)}${b._trade_agreement.in_force ? `, in force ${b._trade_agreement.in_force}` : ''}`
                    : undefined,
                  href: b._trade_agreement ? agreementPath(b._trade_agreement.agreement_id) : undefined,
                  note: b._trade_agreement ? '(registry record: dates and catalogue IDs)' : undefined,
                },
              ]}
            />
          </section>

          {hasStructure && (
            <section class="card-section" aria-labelledby="structure">
              <h2 id="structure">Structure</h2>
              <Facts
                rows={[
                  { label: 'Predecessor', value: b._predecessor ? (b._predecessor.name ?? b._predecessor.id) : undefined, href: refLink(b._predecessor) },
                  { label: 'Successor', value: b._successor ? (b._successor.name ?? b._successor.id) : undefined, href: refLink(b._successor) },
                ]}
              />
              {b._parents.length > 0 && (
                <>
                  <h3>Part of</h3>
                  <ul>
                    {b._parents.map((p) => (
                      <li>{p.exists ? <a href={blockPath(p.id)}>{p.name}</a> : <code>{p.id}</code>}</li>
                    ))}
                  </ul>
                </>
              )}
              {b._children.length > 0 && (
                <>
                  <h3>Suborganizations and bodies ({b._children.length})</h3>
                  <ul>
                    {b._children.map((c) => (
                      <li>
                        {c.exists ? <a href={blockPath(c.id)}>{c.name}</a> : (c.name ?? c.id)} <code class="muted small">{c.id}</code>
                      </li>
                    ))}
                  </ul>
                </>
              )}
              {(b.previous_names?.length ?? 0) > 0 && (
                <>
                  <h3>Previous names</h3>
                  <ul>
                    {b.previous_names!.map((p) => (
                      <li lang={p.id}>
                        {p.name}
                        {p.period && <span class="muted"> ({p.period})</span>}
                      </li>
                    ))}
                  </ul>
                </>
              )}
            </section>
          )}

          {design.length > 0 && (
            <section class="card-section" aria-labelledby="design">
              <h2 id="design">Institutional design</h2>
              <p class="muted small">
                What the founding instrument lets the organization decide and enforce. A field that is not listed is unknown;
                the sources are under Provenance.
              </p>
              <dl class="facts">
                {design.map((row) => (
                  <>
                    <dt title={row.description || undefined}>{row.label}</dt>
                    <dd data-design={row.field}>
                      {/* One line per value: JSX-style line breaks would put a space before each comma. */}
                      {row.values.map((v, i) => (
                        <>{i > 0 && ', '}{v.country ? v.country.exists ? <a href={countryPath(v.key)}>{v.label}</a> : <code>{v.key}</code> : <span title={v.description || undefined}>{v.label}</span>}</>
                      ))}
                    </dd>
                  </>
                ))}
              </dl>
            </section>
          )}
        </div>

        {b.notes && (
          <section class="card-section" aria-labelledby="notes">
            <h2 id="notes">Notes</h2>
            <p>
              {splitCode(b.notes).map((part) =>
                part.code ? known(part.text) ? <a href={blockPath(part.text)}><code>{part.text}</code></a> : <code>{part.text}</code> : part.text,
              )}
            </p>
          </section>
        )}

        <section class="card-section" aria-labelledby="roster">
          <h2 id="roster">{b._active ? 'Members and participants' : 'Members as recorded'}</h2>
          {b.membership_applicability === 'not_applicable' && b._roster.length === 0 ? (
            <p>
              This record has no country or organization roster by design: membership does not apply, or its members are not
              states (for example NGOs or individuals).
            </p>
          ) : (
            <>
              <p>
                {b._active ? (
                  <>
                    <strong>{num(countryCount)}</strong> current countries and territories
                    {`${statusSummary ? ` (${statusSummary})` : ''}${orgCount > 0 ? `, plus ${orgCount} organizations` : ''}.`}
                  </>
                ) : (
                  <>This {b.dissolved ? 'dissolved' : 'historical'} entity has no current members. The roster below is as recorded.</>
                )}
              </p>
              <MembershipMap block={b} table={listed.length > 0 ? 'roster-table' : undefined} />
              <p class="small js-only">
                {hasTimeline && (
                  <>
                    <a href={path(`explore/timeline/?id=${encodeURIComponent(b.id)}`)}>Accession timeline</a>
                    {' · '}
                  </>
                )}
                <a href={path(`explore/map/?id=${encodeURIComponent(b.id)}`)}>Open in the map explorer</a>
                {b._children.some((c) => c.exists) && (
                  <>
                    {' · '}
                    <a href={path(`explore/hierarchy/?id=${encodeURIComponent(b.id)}`)}>Hierarchy</a>
                  </>
                )}
              </p>
              {blockEmbeddable(b) && <EmbedCode kind="block" id={b.id} name={b._acronym ? `${b.name} (${b._acronym})` : b.name} />}
              {b._roster.length > 0 && (
                <p class="small downloads">
                  Download the roster ({num(b._roster.length)} entries, current and former):
                  <a href={path(`blocks/${b.id.toLowerCase()}/members.csv`)} download={`${b.id}-members.csv`}>CSV</a>
                  {' · '}
                  <a href={blockJson(b.id)}>JSON</a>
                </p>
              )}
              {listed.length > 0 && (
                <>
                  <div class="filters js-only" data-table-tools="roster-table">
                    <label>
                      Search
                      <input type="search" data-filter="text" placeholder="Country or code" />
                    </label>
                    <label>
                      Status
                      <select data-filter="status">
                        <option value="">All</option>
                        {statusOptions.map((s) => (
                          <option value={s}>{statusLabel(s)}</option>
                        ))}
                      </select>
                    </label>
                    <span class="count" data-count aria-live="polite" />
                  </div>
                  <div class="table-wrap">
                    <table class="data" id="roster-table">
                      <thead>
                        <tr>
                          <th scope="col" data-sort="text">Name</th>
                          <th scope="col" data-sort="text">Code</th>
                          {listedCols.type && <th scope="col" data-sort="text">Type</th>}
                          <th scope="col" data-sort="text" data-status-col>Status</th>
                          {listedCols.role && <th scope="col" data-sort="text">Route role</th>}
                          {listedCols.joined && <th scope="col" data-sort="text">Joined</th>}
                          {!b._active && listedCols.left && <th scope="col" data-sort="text">Left</th>}
                        </tr>
                      </thead>
                      <tbody>
                        {listed.map((r) => (
                          <tr data-status={r.status} data-member={r.id} data-type={r.type} data-current={r.current ? 'yes' : 'no'} data-role={r.role ?? undefined}>
                            <td data-value={r.name ?? r.id}>
                              {r.flag_emoji && <span aria-hidden="true">{r.flag_emoji} </span>}
                              {r.link === 'country' ? (
                                <a href={countryPath(r.id)}>{r.name}</a>
                              ) : r.link === 'block' ? (
                                <a href={blockPath(r.id)}>{r.name}</a>
                              ) : (
                                (r.name ?? r.id)
                              )}
                              {r.note && <div class="muted small">{r.note}</div>}
                            </td>
                            <td>
                              <code>{r.id}</code>
                            </td>
                            {listedCols.type && <td>{enumLabel('include_type', r.type)}</td>}
                            <td>
                              {statusLabel(r.status)}
                              {statusDeprecated(r.status) && <span class="muted small"> (deprecated label)</span>}
                            </td>
                            {listedCols.role && <td title={roleDescription(r.role) || undefined}>{roleLabel(r.role)}</td>}
                            {listedCols.joined && <td class="date">{r.joined}</td>}
                            {!b._active && listedCols.left && <td class="date">{r.left}</td>}
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                  <StatusDefs table="roster-table" statuses={statusOptions} />
                </>
              )}
              {b._active && other.length > 0 && (
                <details>
                  <summary>Former members and participants ({other.length})</summary>
                  <div class="table-wrap">
                    <table class="data" id="former-table">
                      <thead>
                        <tr>
                          <th scope="col">Name</th>
                          <th scope="col">Code</th>
                          {otherCols.type && <th scope="col">Type</th>}
                          <th scope="col">Status</th>
                          {otherCols.role && <th scope="col">Route role</th>}
                          {otherCols.joined && <th scope="col">Joined</th>}
                          {otherCols.left && <th scope="col">Left</th>}
                        </tr>
                      </thead>
                      <tbody>
                        {other.map((r) => (
                          <tr data-member={r.id} data-type={r.type} data-current="no" data-role={r.role ?? undefined}>
                            <td>
                              {r.link === 'country' ? (
                                <a href={countryPath(r.id)}>{r.name}</a>
                              ) : r.link === 'block' ? (
                                <a href={blockPath(r.id)}>{r.name}</a>
                              ) : (
                                (r.name ?? r.id)
                              )}
                              {r.note && <div class="muted small">{r.note}</div>}
                            </td>
                            <td>
                              <code>{r.id}</code>
                            </td>
                            {otherCols.type && <td>{enumLabel('include_type', r.type)}</td>}
                            <td>
                              {statusLabel(r.status)}
                              {statusDeprecated(r.status) && <span class="muted small"> (deprecated label)</span>}
                            </td>
                            {otherCols.role && <td title={roleDescription(r.role) || undefined}>{roleLabel(r.role)}</td>}
                            {otherCols.joined && <td class="date">{r.joined}</td>}
                            {otherCols.left && <td class="date">{r.left}</td>}
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                </details>
              )}
              {series.length > 0 && (
                <>
                  <h3 id="growth">Membership over time</h3>
                  <figure class="chart" set:html={steps({ points: series, title: `${b.name}: member countries and territories by year` })} />
                  <p class="muted small">
                    {`Countries and territories that were members in each year, from the joining and leaving dates: ${num(dated)} of ${num(countryRows.length)} have a joining date${dated < countryRows.length ? `; the other ${num(countryRows.length - dated)} are not counted` : ''}.`}
                    <span class="js-only">
                      {' '}
                      <a href={path(`explore/timeline/?id=${encodeURIComponent(b.id)}`)}>Play the accession timeline</a>.
                    </span>
                  </p>
                  <details>
                    <summary class="small">Data behind this chart</summary>
                    <div class="table-wrap" tabindex="0" role="region" aria-label="Members by year">
                      <table class="data">
                        <thead>
                          <tr>
                            <th scope="col">Year</th>
                            <th scope="col" class="num">Members</th>
                          </tr>
                        </thead>
                        <tbody>
                          {seriesChanges.map((p) => (
                            <tr>
                              <td>{p.year}</td>
                              <td class="num">{num(p.value)}</td>
                            </tr>
                          ))}
                        </tbody>
                      </table>
                    </div>
                  </details>
                </>
              )}
            </>
          )}
        </section>

        {b._party_to_agreements.length > 0 && (
          <section class="card-section" aria-labelledby="trade">
            <h2 id="trade">Trade agreements</h2>
            <p>
              {`${b._acronym ?? b.name} is itself a party to ${num(b._party_to_agreements.length)} trade ${b._party_to_agreements.length === 1 ? 'agreement' : 'agreements'} in the registry. Its current members are covered through it; the country cards list these agreements with "via ${b.id}".`}
            </p>
            <div class="filters js-only" data-table-tools="bloc-trade-table">
              <label>
                Search
                <input type="search" data-filter="text" placeholder="Agreement or ID" />
              </label>
              <span class="count" data-count aria-live="polite" />
            </div>
            <div class="table-wrap">
              <table class="data" id="bloc-trade-table">
                <thead>
                  <tr>
                    <th scope="col">Agreement</th>
                    <th scope="col">Type</th>
                    <th scope="col">Status</th>
                    <th scope="col">In force</th>
                  </tr>
                </thead>
                <tbody>
                  {b._party_to_agreements.map((r) => (
                    <tr data-agreement={r.agreement_id} data-status={r.status ?? ''}>
                      <td>
                        <a href={agreementPath(r.agreement_id)}>{r.name}</a>
                        {r.agreement_id !== r.acronym && <code class="inline-id">{r.agreement_id}</code>}
                        {r.party_status === 'former_party' && <span class="muted small"> (former party)</span>}
                      </td>
                      <td>{agreementTypeLabel(r.agreement_type)}</td>
                      <td>{agreementStatusLabel(r.status)}</td>
                      <td class="date">{r.in_force}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </section>
        )}

        {b._similar.length > 0 && (
          <section class="card-section" aria-labelledby="overlap">
            <h2 id="overlap">Overlapping organizations</h2>
            <p class="muted small">
              By overlap of current member countries (Jaccard index: shared ÷ combined).
              <a href={path(`explore/compare/?ids=${encodeURIComponent([b.id, ...b._similar.slice(0, 3).map((s) => s.id)].join(','))}`)}>Compare them</a>.
            </p>
            <div class="table-wrap">
              <table class="data">
                <thead>
                  <tr>
                    <th scope="col">Organization or grouping</th>
                    <th scope="col" class="num">Shared members</th>
                    <th scope="col" class="num">Jaccard</th>
                  </tr>
                </thead>
                <tbody>
                  {b._similar.map((s) => (
                    <tr>
                      <td>
                        <a href={blockPath(s.id)}>{s.name}</a>
                        {s.acronym && <span class="muted"> ({s.acronym})</span>}
                      </td>
                      <td class="num">{num(s.shared)}</td>
                      <td class="num">{s.jaccard.toFixed(2)}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </section>
        )}

        {(acronyms.length > 0 || (b.other_names?.length ?? 0) > 0) && (
          <section class="card-section" aria-labelledby="names">
            <h2 id="names">Names</h2>
            {acronyms.length > 0 && (
              <>
                <h3>Acronyms</h3>
                <ul class="names">
                  {acronyms.map((a) => (
                    <li>
                      <span class="lang">{a.lang}</span>
                      <bdi lang={a.lang}>{a.value}</bdi>
                    </li>
                  ))}
                </ul>
              </>
            )}
            {(b.other_names?.length ?? 0) > 0 && (
              <>
                <h3>In other languages ({b.other_names!.length})</h3>
                <ul class="names">
                  {b
                    .other_names!.slice()
                    .sort((x, y) => x.id.localeCompare(y.id))
                    .map((n) => (
                      <li>
                        <span class="lang">{n.id}</span>
                        <bdi lang={n.id}>{n.name}</bdi>
                      </li>
                    ))}
                </ul>
              </>
            )}
          </section>
        )}

        {links.length > 0 && (
          <section class="card-section" aria-labelledby="links">
            <h2 id="links">Links</h2>
            <ul>
              {links.map((l) => (
                <li>
                  <span class="muted">{l.label}:</span> <a href={l.url}>{l.url}</a>
                </li>
              ))}
            </ul>
          </section>
        )}

        {(b.provenance?.length ?? 0) > 0 && (
          <section class="card-section" aria-labelledby="provenance">
            <h2 id="provenance">Provenance</h2>
            <div class="table-wrap">
              <table class="data">
                <thead>
                  <tr>
                    <th scope="col">Field</th>
                    <th scope="col">Source</th>
                    <th scope="col">Retrieved</th>
                    <th scope="col">Licence</th>
                  </tr>
                </thead>
                <tbody>
                  {b.provenance!.map((p) => (
                    <tr>
                      <td>
                        <code>{p.field}</code>
                      </td>
                      <td>{p.url ? <a href={p.url}>{p.source}</a> : p.source}</td>
                      <td>{p.retrieved_at}</td>
                      <td>{p.license}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </section>
        )}
      </div>
      <script>
        import '../../../scripts/tables.ts';
      </script>
    </Base>
  )
}
