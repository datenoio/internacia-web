---
import '../styles/global.css';
import { INDEXABLE } from '../../site.config.mjs';
import { breadcrumbList, graph, toScript } from '../lib/jsonld';
import { meta } from '../lib/meta';
import { path, REPO_DATA, REPO_SITE } from '../lib/urls';

interface Crumb {
  name: string;
  href: string;
}

interface Props {
  title: string;
  description: string;
  breadcrumbs?: Crumb[];
  markdown?: string;
  json?: string;
  sourceUrl?: string;
  reportUrl?: string;
  jsonld?: Record<string, unknown>[];
  canonical?: string;
  noindex?: boolean;
}

const { title, description, breadcrumbs = [], markdown, json, sourceUrl, reportUrl, jsonld = [], noindex } = Astro.props;
const base = path();
const canonical = Astro.props.canonical ?? new URL(Astro.url.pathname, Astro.site).href;
const fullTitle = title === 'Internacia' ? title : `${title} · Internacia`;
const releaseDate = meta.data.build_date.slice(0, 10);
const crumbs: Crumb[] = breadcrumbs.length ? [{ name: 'Home', href: base }, ...breadcrumbs] : [];
const ld = crumbs.length || jsonld.length ? graph(...jsonld, ...(crumbs.length ? [breadcrumbList(crumbs)] : [])) : null;
const nav = [
  { href: path('countries/'), label: 'Countries' },
  { href: path('blocks/'), label: 'Organizations' },
  { href: path('types/'), label: 'Types' },
  { href: path('topics/'), label: 'Topics' },
  { href: path('geography/'), label: 'Geography' },
  { href: path('stats/'), label: 'Statistics' },
  { href: path('data/'), label: 'Data & API' },
  { href: path('about/'), label: 'About' },
];
const current = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {(!INDEXABLE || noindex) && <meta name="robots" content="noindex, nofollow" />}
    <meta name="color-scheme" content="light dark" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Internacia" />
    <link rel="icon" type="image/svg+xml" href={path('favicon.svg')} />
    {markdown && <link rel="alternate" type="text/markdown" href={markdown} />}
    {json && <link rel="alternate" type="application/json" href={json} />}
    <link rel="help" type="text/plain" href={path('llms.txt')} />
    <link rel="alternate" type="application/atom+xml" title="internacia-db data releases" href={path('feed.xml')} />
    {ld && <script type="application/ld+json" set:html={toScript(ld)} />}
    <slot name="head" />
    <script is:inline>
      (() => {
        // Elements that need JavaScript are styled .js-only; this class shows them from the
        // first paint, so they never shift the layout when scripts attach behaviour.
        document.documentElement.classList.add('js');
        try {
          const theme = localStorage.getItem('theme');
          if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
        } catch {}
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <header class="site-header">
      <div class="container">
        <a class="site-title" href={base}>Internacia</a>
        <nav class="site-nav" aria-label="Main">
          <ul>
            {
              nav.map((item) => (
                <li>
                  <a href={item.href} aria-current={current.startsWith(item.href) ? 'page' : undefined}>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <div class="finder js-only" data-finder data-index={path('api/v1/search-index.json')}>
          <label class="visually-hidden" for="finder-input">Find a country or organization</label>
          <input
            id="finder-input"
            type="search"
            role="combobox"
            aria-autocomplete="list"
            aria-expanded="false"
            aria-controls="finder-results"
            placeholder="Find: France, НАТО, 北约, G-20…"
            autocomplete="off"
            spellcheck="false"
          />
          <ul id="finder-results" role="listbox" aria-label="Matches" hidden></ul>
        </div>
        <button class="theme-toggle js-only" id="theme-toggle" type="button">Theme: auto</button>
      </div>
    </header>

    {
      crumbs.length > 0 && (
        <nav class="container breadcrumbs" aria-label="Breadcrumb">
          <ol>
            {crumbs.map((c, i) => (
              <li>{i === crumbs.length - 1 ? <span aria-current="page">{c.name}</span> : <a href={c.href}>{c.name}</a>}</li>
            ))}
          </ol>
        </nav>
      )
    }

    <main id="content">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        {
          (markdown || json || sourceUrl || reportUrl) && (
            <p class="page-links">
              {markdown && <a href={markdown}>View as Markdown</a>}
              {json && <a href={json}>View as JSON</a>}
              {sourceUrl && <a href={sourceUrl}>Source record on GitHub</a>}
              {reportUrl && <a href={reportUrl}>Report a data error</a>}
            </p>
          )
        }
        <p>
          Data: <a href={meta.data.release_url}>internacia-db v{meta.data.version}</a>
          (contract {meta.data.contract_version}), released {releaseDate}. Licensed
          <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>; country centroids
          ODbL 1.0. See the <a href={path('about/')}>attribution</a>.
        </p>
        <p>
          Site code: <a href={REPO_SITE}>MIT</a>. Part of the <a href="https://dateno.io">Dateno</a>
          open-source project. For AI agents: <a href={path('llms.txt')}>llms.txt</a>. Report data errors in
          <a href={`${REPO_DATA}/issues`}>internacia-db issues</a>.
        </p>
      </div>
    </footer>

    <script>
      import '../scripts/finder.ts';
    </script>
    <script is:inline>
      (() => {
        const button = document.getElementById('theme-toggle');
        const modes = ['auto', 'light', 'dark'];
        const read = () => {
          try {
            return localStorage.getItem('theme') ?? 'auto';
          } catch {
            return 'auto';
          }
        };
        const apply = (mode) => {
          const root = document.documentElement;
          try {
            if (mode === 'auto') localStorage.removeItem('theme');
            else localStorage.setItem('theme', mode);
          } catch {}
          if (mode === 'auto') delete root.dataset.theme;
          else root.dataset.theme = mode;
          button.textContent = `Theme: ${mode}`;
        };
        button.addEventListener('click', () => apply(modes[(modes.indexOf(read()) + 1) % modes.length]));
        button.textContent = `Theme: ${read()}`;

        // Copy buttons for codes and IDs (.js-only: not shown without JavaScript).
        document.querySelectorAll('button[data-copy]').forEach((btn) => {
          btn.addEventListener('click', async () => {
            try {
              await navigator.clipboard.writeText(btn.dataset.copy);
              btn.textContent = 'Copied';
              setTimeout(() => (btn.textContent = 'Copy'), 1500);
            } catch {}
          });
        });
      })();
    </script>
  </body>
</html>
