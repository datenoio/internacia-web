---
import '../styles/global.css';
import { INDEXABLE } from '../../site.config.mjs';
import { breadcrumbList, graph, toScript } from '../lib/jsonld';
import { meta } from '../lib/meta';
import { absolute, path, REPO_DATA, REPO_SITE } from '../lib/urls';

interface Crumb {
  name: string;
  href: string;
}

interface Props {
  title: string;
  description: string;
  breadcrumbs?: Crumb[];
  markdown?: string;
  json?: string;
  sourceUrl?: string;
  reportUrl?: string;
  jsonld?: Record<string, unknown>[];
  canonical?: string;
  noindex?: boolean;
  // Section name for full-text search filters (Pagefind); pages without one are not indexed.
  section?: string;
  ogImage?: string;
  ogAlt?: string;
}

const { title, description, breadcrumbs = [], markdown, json, sourceUrl, reportUrl, jsonld = [], noindex, section } = Astro.props;
const ogImage = absolute(Astro.props.ogImage ?? path('og/default.png'));
const ogAlt = Astro.props.ogAlt ?? 'Internacia: countries, international organizations and country groupings';
const searchable = !noindex && Boolean(section);
const base = path();
const canonical = Astro.props.canonical ?? new URL(Astro.url.pathname, Astro.site).href;
const fullTitle = title === 'Internacia' ? title : `${title} · Internacia`;
const releaseDate = meta.data.build_date.slice(0, 10);
const crumbs: Crumb[] = breadcrumbs.length ? [{ name: 'Home', href: base }, ...breadcrumbs] : [];
const ld = crumbs.length || jsonld.length ? graph(...jsonld, ...(crumbs.length ? [breadcrumbList(crumbs)] : [])) : null;
// Main sections stay in the header row; browse facets and reference pages sit under "More".
// Below the wide layout every section is in one "Menu".
const nav = [
  { href: path('countries/'), label: 'Countries' },
  { href: path('blocks/'), label: 'Organizations' },
  { href: path('explore/'), label: 'Explore' },
  { href: path('data/'), label: 'Data & API' },
];
const more = [
  { href: path('agreements/'), label: 'Trade agreements' },
  { href: path('types/'), label: 'Block types' },
  { href: path('topics/'), label: 'Topics' },
  { href: path('geography/'), label: 'Geography' },
  { href: path('stats/'), label: 'Statistics' },
  { href: path('about/'), label: 'About' },
];
// The one inline script, in <head> before the first paint: elements that need JavaScript are
// styled .js-only and the class "js" shows them from the first paint, so they never shift the
// layout when scripts attach behaviour; a stored theme applies before anything is drawn. It is
// written compact because it is repeated in every page (SPEC §10.3, site size).
const FIRST_PAINT =
  "(()=>{const d=document.documentElement;d.classList.add('js');try{const t=localStorage.getItem('theme');if(t==='light'||t==='dark')d.dataset.theme=t}catch{}})()";
const current = Astro.url.pathname;
const isCurrent = (href: string) => current.startsWith(href);
const moreCurrent = more.some((item) => isCurrent(item.href));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {(!INDEXABLE || noindex) && <meta name="robots" content="noindex, nofollow" />}
    <meta name="color-scheme" content="light dark" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Internacia" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href={path('favicon.svg')} />
    {markdown && <link rel="alternate" type="text/markdown" href={markdown} />}
    {json && <link rel="alternate" type="application/json" href={json} />}
    <link rel="help" type="text/plain" href={path('llms.txt')} />
    <link rel="alternate" type="application/atom+xml" title="internacia-db data releases" href={path('feed.xml')} />
    {ld && <script type="application/ld+json" set:html={toScript(ld)} />}
    <slot name="head" />
    <script is:inline set:html={FIRST_PAINT} />
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <header class="site-header">
      <div class="container">
        <a class="site-title" href={base}>Internacia</a>
        <div class="finder js-only" data-finder data-index={path('api/v1/search-index.json')} data-search={path('search/')}>
          <label class="visually-hidden" for="finder-input">Find a country or organization</label>
          <input
            id="finder-input"
            type="search"
            role="combobox"
            aria-autocomplete="list"
            aria-expanded="false"
            aria-controls="finder-results"
            placeholder="Find: France, НАТО, 北约, G-20…"
            autocomplete="off"
            spellcheck="false"
          />
          <ul id="finder-results" role="listbox" aria-label="Matches" hidden></ul>
        </div>
        <nav class="site-nav" aria-label="Main">
          <ul class="nav-wide">
            {
              nav.map((item) => (
                <li><a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a></li>
              ))
            }
            <li>
              <details class="nav-drop" data-nav-drop>
                <summary class={moreCurrent ? 'current' : undefined}>More</summary>
                <ul>
                  {
                    more.map((item) => (
                      <li><a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a></li>
                    ))
                  }
                </ul>
              </details>
            </li>
          </ul>
          <details class="nav-drop nav-narrow" data-nav-drop>
            <summary>Menu</summary>
            <ul>
              {
                [...nav, ...more].map((item) => (
                  <li><a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a></li>
                ))
              }
            </ul>
          </details>
        </nav>
        <button class="theme-toggle js-only" id="theme-toggle" type="button" aria-label="Theme: auto"></button>
      </div>
    </header>

    {
      crumbs.length > 0 && (
        <nav class="container breadcrumbs" aria-label="Breadcrumb">
          <ol>
            {crumbs.map((c, i) => (
              <li>{i === crumbs.length - 1 ? <span aria-current="page">{c.name}</span> : <a href={c.href}>{c.name}</a>}</li>
            ))}
          </ol>
        </nav>
      )
    }

    <main id="content" data-pagefind-body={searchable ? '' : undefined}>
      {searchable && <span hidden data-pagefind-filter="section">{section}</span>}
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        {
          (markdown || json || sourceUrl || reportUrl) && (
            <p class="page-links">
              {markdown && <a href={markdown}>View as Markdown</a>}
              {json && <a href={json}>View as JSON</a>}
              {sourceUrl && <a href={sourceUrl}>Source record on GitHub</a>}
              {reportUrl && <a href={reportUrl}>Report a data error</a>}
            </p>
          )
        }
        <p>
          Data: <a href={meta.data.release_url}>internacia-db v{meta.data.version}</a>
          (contract {meta.data.contract_version}), released {releaseDate}. Licensed
          <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>; country centroids
          ODbL 1.0. See the <a href={path('about/')}>attribution</a>.
        </p>
        <p>
          Site code: <a href={REPO_SITE}>MIT</a>. Part of the <a href="https://dateno.io">Dateno</a>
          open-source project. For AI agents: <a href={path('llms.txt')}>llms.txt</a>. Report data errors in
          <a href={`${REPO_DATA}/issues`}>internacia-db issues</a>.
        </p>
      </div>
    </footer>

    <script>
      // One bundled module for every page (cached once), instead of inline code repeated in each
      // of the ~4,800 pages: the finder, then the header, theme, copy buttons and in-page nav.
      import '../scripts/finder.ts';
      import '../scripts/site.ts';
    </script>
  </body>
</html>
