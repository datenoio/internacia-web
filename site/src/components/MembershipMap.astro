---
// Membership map (SPEC §8, V1) and country locator map. The base map is one static SVG
// (/assets/world.svg) fetched and coloured in the browser; the facts are in the table next to the
// map, so the map only enhances. Colours: dataviz reference palette, slots 1–3 (validated
// all-pairs in light and dark), plus a hatched neutral for former members.
import type { Block, Country } from '../lib/data';
import { statusLabel } from '../lib/format';
import { onMap, worldMap } from '../lib/worldmap';
import { binFor, MEMBERSHIP_BINS } from '../lib/series';
import { countryByCode } from '../lib/data';
import { path } from '../lib/urls';

interface Props {
  block?: Block;
  country?: Country;
  // A set of countries to highlight (geography pages).
  area?: { name: string; codes: string[] };
  // A value per country, shown as a sequential choropleth (home page, SPEC §8 V2).
  values?: { label: string; data: Record<string, number> };
  // In an embedded widget, the full list is on the card rather than on the same page.
  cardHref?: string;
}

type Group = 'm' | 'p' | 'o' | 'f';
const GROUPS: Record<Group, string> = {
  m: 'Member',
  p: 'Other participation',
  o: 'Observer',
  f: 'Former member',
};
const RANK: Record<Group, number> = { m: 4, p: 3, o: 2, f: 1 };

const groupOf = (status: string): Group =>
  status === 'member' || status === 'founding_member'
    ? 'm'
    : status === 'observer'
      ? 'o'
      : status === 'former_member'
        ? 'f'
        : 'p';

const { block, country, area, values, cardHref } = Astro.props;
// Entry: [CSS class, value label, joined date, name]
const data: Record<string, [string, string, string, string]> = {};
let caption = '';
let summary = '';

if (block) {
  for (const r of block._roster) {
    if (r.link !== 'country' || !onMap(r.id)) continue;
    const g: Group = block._active ? (r.current ? groupOf(r.status) : 'f') : groupOf(r.status);
    const prev = data[r.id];
    if (!prev || RANK[g] > RANK[prev[0].slice(2) as Group]) {
      data[r.id] = [`g-${g}`, statusLabel(r.status), r.joined ?? '', r.name ?? r.id];
    }
  }
  caption = block._active
    ? `Countries and territories in ${block.name}, by membership status`
    : `Countries and territories in ${block.name}, as recorded (the entity is no longer active)`;
  const counts = Object.values(data).reduce<Record<string, number>>((acc, [g]) => ({ ...acc, [g.slice(2)]: (acc[g.slice(2)] ?? 0) + 1 }), {});
  summary = (Object.keys(GROUPS) as Group[])
    .filter((g) => counts[g])
    .map((g) => `${counts[g]} ${GROUPS[g].toLowerCase()}`)
    .join(', ');
} else if (country && onMap(country.code)) {
  data[country.code] = ['g-m', 'Location', '', country.name];
  caption = `Location of ${country.name}`;
  summary = caption;
} else if (area) {
  for (const code of area.codes) {
    if (onMap(code)) data[code] = ['g-m', area.name, '', countryByCode().get(code)?.name ?? code];
  }
  caption = `Countries and territories in ${area.name}`;
  summary = `${Object.keys(data).length} shown`;
} else if (values) {
  for (const [code, n] of Object.entries(values.data)) {
    const bin = binFor(n);
    if (bin && onMap(code)) data[code] = [bin.cls, `${n} ${values.label}`, '', countryByCode().get(code)?.name ?? code];
  }
  caption = `Countries and territories by number of ${values.label}`;
  summary = MEMBERSHIP_BINS.map((b) => b.label).join(', ');
}

const present = (Object.keys(GROUPS) as Group[]).filter((g) => Object.values(data).some(([x]) => x === `g-${g}`));
const bins = values ? MEMBERSHIP_BINS.filter((b) => Object.values(data).some(([x]) => x === b.cls)) : [];
const show = Object.keys(data).length > 0;
// The canvas keeps the map's aspect ratio before the SVG arrives, so nothing shifts.
const ratio = `--map-ratio: ${worldMap().width} / ${worldMap().height}`;
---

{
  show && (
    <figure class={`map${country ? ' map-locator' : ''}`} data-map data-src={path('assets/world.svg')}>
      <div
        class="map-canvas js-only"
        style={ratio}
        role="img"
        aria-label={`${caption}: ${summary}. ${cardHref ? 'The full list is on the Internacia card.' : 'The table on this page lists every entry.'}`}
      />
      <noscript>
        {cardHref ? (
          <p class="muted small">
            The map needs JavaScript; <a href={cardHref}>the Internacia card</a> lists the same data.
          </p>
        ) : (
          <p class="muted small">The map needs JavaScript; the table on this page lists the same data.</p>
        )}
      </noscript>
      <script type="application/json" data-map-data set:html={JSON.stringify(data).replace(/</g, '\\u003c')} />
      <div class="map-tip" hidden />
      <figcaption>
        {block && (
          <ul class="legend">
            {present.map((g) => (
              <li>
                <span class={`swatch g-${g}`} aria-hidden="true" />
                {GROUPS[g]}
              </li>
            ))}
          </ul>
        )}
        {values && (
          <ul class="legend" aria-label={`Number of ${values.label}`}>
            {bins.map((b) => (
              <li>
                <span class={`swatch ${b.cls}`} aria-hidden="true" />
                {b.label}
              </li>
            ))}
          </ul>
        )}
        <span class="muted small">
          {caption}. Small territories are shown as dots. Base map: Natural Earth (public domain); boundaries do not imply
          endorsement.
        </span>
      </figcaption>
    </figure>
  )
}

<script>
  import '../scripts/map.ts';
</script>
