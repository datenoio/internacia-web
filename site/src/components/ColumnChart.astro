---
// Single-series column chart, server-rendered SVG (SPEC §8: SVG first, data table always).
// One hue (series-1), no legend (the heading names the series), columns <= 24px with a 4px
// rounded top and a square base, a 2px surface gap between columns, recessive axis, value
// labels on the largest column only, a hover/focus tooltip through <title>.
interface Item {
  label: string;
  value: number;
}

interface Props {
  items: Item[];
  label: string;
  unit?: string;
  labelEvery?: number;
}

const { items, label, unit = '', labelEvery = 1 } = Astro.props;
const fmt = new Intl.NumberFormat('en');
const W = 720;
const H = 200;
const PAD = { top: 18, right: 8, bottom: 28, left: 36 };
const innerW = W - PAD.left - PAD.right;
const innerH = H - PAD.top - PAD.bottom;
const max = Math.max(1, ...items.map((i) => i.value));
const step = items.length ? innerW / items.length : innerW;
const barW = Math.max(2, Math.min(24, step - 2));
const niceMax = (() => {
  const p = 10 ** Math.floor(Math.log10(max));
  return [1, 2, 2.5, 5, 10].map((m) => m * p).find((v) => v >= max) ?? max;
})();
const ticks = [0, niceMax / 2, niceMax];
const y = (v: number) => PAD.top + innerH - (v / niceMax) * innerH;
const peak = items.reduce((best, i) => (i.value > best.value ? i : best), items[0] ?? { label: '', value: 0 });
const r = 4;
const column = (x: number, top: number, w: number) => {
  const h = PAD.top + innerH - top;
  if (h <= r) return `M${x},${PAD.top + innerH}V${top}H${x + w}V${PAD.top + innerH}Z`;
  return `M${x},${PAD.top + innerH}V${top + r}Q${x},${top} ${x + r},${top}H${x + w - r}Q${x + w},${top} ${x + w},${top + r}V${PAD.top + innerH}Z`;
};
---

<figure class="chart">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`${label}. The table below lists every value.`}>
    {
      ticks.map((t) => (
        <g class="tick">
          <line x1={PAD.left} x2={W - PAD.right} y1={y(t)} y2={y(t)} />
          <text x={PAD.left - 6} y={y(t) + 4} text-anchor="end">
            {fmt.format(t)}
          </text>
        </g>
      ))
    }
    {
      items.map((item, i) => {
        const x = PAD.left + i * step + (step - barW) / 2;
        const top = y(item.value);
        return (
          <g class="col" tabindex="0" role="img" aria-label={`${item.label}: ${fmt.format(item.value)}${unit}`}>
            <title>{`${item.label}: ${fmt.format(item.value)}${unit}`}</title>
            <rect class="hit" x={PAD.left + i * step} y={PAD.top} width={step} height={innerH} />
            {item.value > 0 && <path class="bar" d={column(x, top, barW)} />}
            {i % labelEvery === 0 && (
              <text class="axis" x={x + barW / 2} y={H - 10} text-anchor="middle">
                {item.label}
              </text>
            )}
            {item === peak && item.value > 0 && (
              <text class="value" x={x + barW / 2} y={top - 5} text-anchor="middle">
                {fmt.format(item.value)}
              </text>
            )}
          </g>
        );
      })
    }
    <line class="baseline" x1={PAD.left} x2={W - PAD.right} y1={PAD.top + innerH} y2={PAD.top + innerH} />
  </svg>
  <details>
    <summary class="small">Data behind this chart</summary>
    <div class="table-wrap">
      <table class="data">
        <thead>
          <tr>
            <th scope="col">{label.split(' by ')[1] ?? 'Category'}</th>
            <th scope="col" class="num">Value</th>
          </tr>
        </thead>
        <tbody>
          {
            items.map((item) => (
              <tr>
                <td>{item.label}</td>
                <td class="num">{fmt.format(item.value)}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </details>
</figure>
