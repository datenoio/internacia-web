---
// Text input with a datalist of every intblock ("ID — Name (ACR)"); explorers read the ID before " — ".
import { blocks } from '../lib/data';

interface Props {
  id: string;
  label?: string;
}

const { id, label = 'Organization or grouping' } = Astro.props;
const options = blocks()
  .slice()
  .sort((a, b) => a.name.localeCompare(b.name))
  .map((b) => `${b.id} — ${b.name}${b._acronym ? ` (${b._acronym})` : ''}`);
---

<label>
  {label}
  <input type="text" list={`${id}-list`} data-input="block" placeholder="Type a name, acronym or ID" autocomplete="off" />
</label>
<datalist id={`${id}-list`}>{options.map((o) => <option value={o} />)}</datalist>
