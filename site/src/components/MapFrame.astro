---
// Empty base-map figure for explorers; scripts/map.ts renderMap() colours it.
import { path } from '../lib/urls';
import { worldMap } from '../lib/worldmap';

interface Props {
  id: string;
  label: string;
  // id of an element holding a table with tr[data-member] rows (scripts/map.ts data-link-table)
  linkTable?: string;
}

const { id, label, linkTable } = Astro.props;
const ratio = `--map-ratio: ${worldMap().width} / ${worldMap().height}`;
---

<figure class="map" id={id} data-map data-src={path('assets/world.svg')} data-card-base={path('countries/')} data-link-table={linkTable}>
  <button type="button" class="map-zoom js-only" data-map-zoom data-in="Zoom to the countries shown" data-out="Show the whole world" hidden>
    Show the whole world
  </button>
  <div class="map-canvas js-only" style={ratio} role="group" aria-label={label}></div>
  <div class="map-tip" hidden></div>
  <figcaption>
    <ul class="legend" data-legend></ul>
    <span class="muted small" data-caption></span>
    <span class="muted small">Small territories are shown as dots. Base map: Natural Earth (public domain); boundaries do not imply endorsement.</span>
  </figcaption>
</figure>
